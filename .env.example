# Copie este arquivo para .env. Use chave NVIDIA ou deixe-a vazia para Ollama local.
# Gere a chave em https://build.nvidia.com/settings/api-keys (começa com nvapi-).

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...

# Sem chave da NVIDIA, deixe LLM_API_KEY vazia para usar Ollama local.
# O Ollama deve estar instalado e executando. Modelo padrão: qwen2.5:3b.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b

# Gerador de questões.
# ATENÇÃO: models.list() mostra o catálogo inteiro, mas cada conta só pode
# invocar alguns modelos (os demais dão 404 "Function not found for account").
# Rode dev/test_modelos.py --todos para ver os liberados na SUA conta.
# Liberados em 2026-10 (conta da equipe): nemotron-3-ultra-550b-a55b, glm-5.3,
# gpt-oss-20b, nemotron-3.5-lightning-30b-a3b, deepseek-v4.1-flash,
# step-5-preview.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL=z-ai/glm-5.3
# LLM_MODEL=openai/gpt-oss-20b
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_MODEL=deepseek-ai/deepseek-v4.1-flash

# Raciocínio estendido do Nemotron (chat_template_kwargs.enable_thinking).
# Em modelos que não suportam o parâmetro, deixe desligado.
LLM_THINKING=false
# Limite de tokens da resposta (opcional; o Nemotron aceita até 16384).
LLM_MAX_TOKENS=16384
