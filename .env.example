# Copie este arquivo para .env.
# Provedor principal da demo: NVIDIA NIM (API gratuita, sem cartão).
# Gere a chave em https://build.nvidia.com/settings/api-keys (começa com nvapi-).

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...

# Ollama local é OPCIONAL. Sem chave da NVIDIA, o app só tenta o Ollama se ele
# estiver instalado e respondendo em localhost:11434; caso contrário, mostra um
# erro claro e desabilita a geração. A demo não depende do Ollama.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b

# Gerador de questões.
# ATENÇÃO: models.list() mostra o catálogo inteiro, mas cada conta só pode
# invocar alguns modelos (os demais dão 404 "Function not found for account").
# Rode dev/test_modelos.py --todos para ver os liberados na SUA conta.
# Liberados em 2026-10 (conta da equipe): nemotron-3-ultra-550b-a55b, glm-5.3,
# gpt-oss-20b, nemotron-3.5-lightning-30b-a3b, deepseek-v4.1-flash,
# step-5-preview.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL=z-ai/glm-5.3
# LLM_MODEL=openai/gpt-oss-20b
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_MODEL=deepseek-ai/deepseek-v4.1-flash

# Raciocínio estendido do Nemotron (chat_template_kwargs.enable_thinking).
# Em modelos que não suportam o parâmetro, deixe desligado.
LLM_THINKING=false
# Limite de tokens da resposta (opcional; o Nemotron aceita até 16384).
LLM_MAX_TOKENS=16384

# ---------------------------------------------------------------------------
# Provedores experimentais (opcional). A demo principal usa NVIDIA.
# Deixe LLM_PROVIDER vazio para manter o comportamento acima (NVIDIA ou Ollama).
# Também é possível trocar pelo seletor "Provedor" na interface.
# Valores aceitos: nvidia | ollama | openrouter | groq | gemini.
# Nenhum destes provedores exige cartão; se o free tier der 429, a geração
# para e mostra o erro (não há fallback para modelo pago).
# ---------------------------------------------------------------------------
# LLM_PROVIDER=nvidia
# LLM_PROVIDER=

# OpenRouter (experimental): https://openrouter.ai/settings/keys (sk-or-v1-...).
# Padrão ao selecionar: nvidia/nemotron-3.5-lightning:free
# Somente modelos ":free" aparecem na lista curada. Limite: 20 req/min e
# 50 req/dia nos modelos gratuitos. Se a API recusar por política de dados,
# habilite em Settings -> Privacy o uso de provedores que treinam com dados.
# Teste com: python dev/test_providers.py --provedor openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_REASONING_EFFORT=low
# OPENROUTER_MAX_TOKENS=8192

# Groq (experimental): https://console.groq.com/keys (começa com gsk_).
# Padrão ao selecionar: openai/gpt-oss-120b. Limite: 30 req/min e 1.000 req/dia.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (experimental): https://aistudio.google.com/api-keys (AIza...).
# Padrão ao selecionar: gemini-3.5-flash. Limites variam por modelo no free tier.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash
